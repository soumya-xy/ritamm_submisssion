# Copy this file to .env and fill in your values. Never commit .env.
# We set these same variables with our own values when we run your code.
# LLM credentials (required by the Bank Agent; any OpenAI-compatible endpoint)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Ports for your two agents (use your own defaults if these are not set)
AGENT_A_PORT=8001
AGENT_B_PORT=8002

# Optional: override the pack directory (default: ./pack)
# PACK_DIR=./pack
